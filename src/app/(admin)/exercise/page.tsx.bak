"use client";

import { useEffect, useMemo, useState } from "react";
import { createClient } from "@supabase/supabase-js";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { Skeleton } from "@/components/ui/skeleton";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
  AlertDialogTrigger,
} from "@/components/ui/alert-dialog";
import {
  Search,
  Plus,
  Dumbbell,
  CheckCircle,
  XCircle,
  Edit,
  Trash,
  Video,
  Info,
  Settings2,
  Zap,
  Shield,
  Layers,
  Activity
} from "lucide-react";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { ExerciseMixVisual } from "@/components/ExerciseMixVisual";

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
);

interface MixItem {
  id: number;
  name: string;
  weight: number;
}

interface Exercise {
  id: string; // UUID
  name_es: string;
  name_en: string | null;
  description: string | null;
  urlvideo: string | null;
  is_active: boolean;

  // Catalogs
  type_id: number | null;
  difficulty_id: number | null;
  training_method_id: number | null;
  laterality_support_id: number | null;
  laterality_load_id: number | null;
  ssc_demand_id: number | null;
  impact_demand_id: number | null;
  antirotation_stability_id: number | null;
  movement_pattern_id: number | null;

  // Joins
  exercise_type: { name: string } | null;
  difficulty: { name: string } | null;
  training_method: { name: string } | null;
  laterality_support: { name: string } | null;
  laterality_load: { name: string } | null;
  ssc_demand: { name: string } | null;
  impact_demand: { name: string } | null;
  antirotation_stability: { name: string } | null;
  movement_pattern: { name: string } | null;

  // Mixes
  exercise_vector_mix: {
    id: number;
    weight: number;
    dominant_vector: { name: string };
  }[];
  exercise_plane_mix: {
    id: number;
    weight: number;
    plane: { name: string };
  }[];

  // Relations
  exercise_muscle: {
    role: "primary" | "secondary";
    muscle: { name: string };
  }[];
  exercise_equipment: {
    equipment: { id: number; name: string };
  }[];
}

const PAGE_SIZE = 12;

export default function ExercisesCatalog() {
  const [exercises, setExercises] = useState<Exercise[]>([]);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  const [page, setPage] = useState(1);

  const fetchExercises = async () => {
    setLoading(true);
    const { data, error } = await supabase
      .from("exercise")
      .select(`
        *,
        exercise_type:type_id (name),
        difficulty:difficulty_id (name),
        training_method:training_method_id (name),
        laterality_support:laterality_support_id (name),
        laterality_load:laterality_load_id (name),
        ssc_demand:ssc_demand_id (name),
        impact_demand:impact_demand_id (name),
        antirotation_stability:antirotation_stability_id (name),
        movement_pattern:movement_pattern_id (name),
        exercise_vector_mix (
          id, weight, 
          dominant_vector:vector_id (name)
        ),
        exercise_plane_mix (
          id, weight, 
          plane:plane_id (name)
        ),
        exercise_muscle!exercise_muscle_exercise_id_fkey (
          role,
          muscle:muscle_id (name)
        ),
        exercise_equipment (
          equipment:equipment_id (id, name)
        )
      `)
      .order("name_es", { ascending: true });

    if (error) {
      console.error("Error fetching exercises:", error);
    } else {
      setExercises(data || []);
    }
    setLoading(false);
  };

  useEffect(() => {
    fetchExercises();
  }, []);

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();
    return exercises.filter((ex) => {
      const matchesSearch =
        ex.name_es.toLowerCase().includes(q) ||
        (ex.name_en && ex.name_en.toLowerCase().includes(q)) ||
        ex.exercise_muscle.some((em) => em.muscle.name.toLowerCase().includes(q));
      return matchesSearch;
    });
  }, [exercises, search]);

  const paginated = useMemo(() => {
    const start = (page - 1) * PAGE_SIZE;
    return filtered.slice(start, start + PAGE_SIZE);
  }, [filtered, page]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));

  const handleDelete = async (id: string) => {
    const { error } = await supabase.from('exercise').delete().eq('id', id);
    if (error) {
      console.error("Error deleting exercise:", error);
    } else {
      setExercises(prev => prev.filter(ex => ex.id !== id));
    }
  };

  return (
    <div className="min-h-screen gradient-bg text-slate-100 p-4 md:p-8">
      <div className="mx-auto max-w-7xl animate-in fade-in duration-700">

        {/* Glass Header */}
        <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
          <div className="space-y-1">
            <h1 className="text-4xl font-black tracking-tighter flex items-center gap-4 neon-text">
              <div className="p-3 glass-card rounded-2xl neon-border">
                <Dumbbell className="h-8 w-8 text-indigo-400" />
              </div>
              EJERCICIOS
            </h1>
            <p className="text-slate-600 dark:text-slate-400 font-bold ml-1">
              Catálogo inteligente de alto rendimiento
            </p>
          </div>

          <div className="flex gap-3 w-full md:w-auto">
            <div className="relative flex-1 md:w-80">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-500" />
              <Input
                placeholder="Filtrar ejercicios o músculos..."
                value={search}
                onChange={(e) => {
                  setSearch(e.target.value);
                  setPage(1);
                }}
                className="pl-10 bg-white dark:bg-white/5 border-slate-200 dark:border-white/10 glass-card focus:ring-indigo-500/50 text-slate-900 dark:text-slate-100 placeholder:text-slate-400"
              />
            </div>
            <CreateExerciseDialog onSuccess={fetchExercises} />
          </div>
        </div>

        {/* Exercises Grid */}
        {loading ? (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[...Array(6)].map((_, i) => (
              <Skeleton key={i} className="h-72 w-full rounded-2xl bg-white/5" />
            ))}
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {paginated.map((ex) => (
              <ExerciseCard key={ex.id} exercise={ex} onDelete={handleDelete} onEdit={fetchExercises} />
            ))}
            {filtered.length === 0 && (
              <div className="col-span-full py-20 text-center glass-card rounded-3xl border-dashed border-white/10">
                <p className="text-slate-500 text-lg">No se encontraron ejercicios con esos criterios.</p>
              </div>
            )}
          </div>
        )}

        {/* Advanced Pagination */}
        {totalPages > 1 && (
          <div className="flex items-center justify-between mt-12 glass-card p-4 rounded-2xl border-white/5">
            <p className="text-slate-600 dark:text-slate-400 text-sm font-bold">
              Viendo {paginated.length} de {filtered.length} ejercicios
            </p>
            <div className="flex gap-2">
              <Button
                variant="ghost"
                size="sm"
                disabled={page <= 1}
                onClick={() => setPage((p) => p - 1)}
                className="hover:bg-white/10"
              >
                Anterior
              </Button>
              <div className="flex gap-1 items-center px-2">
                {[...Array(totalPages)].map((_, i) => (
                  <button
                    key={i}
                    onClick={() => setPage(i + 1)}
                    className={`h-2 w-2 rounded-full transition-all ${page === i + 1 ? "bg-indigo-500 w-6" : "bg-slate-700"
                      }`}
                  />
                ))}
              </div>
              <Button
                variant="ghost"
                size="sm"
                disabled={page >= totalPages}
                onClick={() => setPage((p) => p + 1)}
                className="hover:bg-white/10"
              >
                Siguiente
              </Button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

function ExerciseCard({ exercise, onDelete, onEdit }: { exercise: Exercise, onDelete: (id: string) => void, onEdit: () => void }) {
  const vectors = exercise.exercise_vector_mix.map(v => ({
    id: v.id,
    name: v.dominant_vector.name,
    weight: v.weight
  }));

  const planes = exercise.exercise_plane_mix.map(p => ({
    id: p.id,
    name: p.plane.name,
    weight: p.weight
  }));

  return (
    <Card className="glass-card hover:neon-border transition-all duration-300 group overflow-hidden border-white/5 bg-white/[0.02]">
      <CardHeader className="pb-2">
        <div className="flex justify-between items-start">
          <Badge className="bg-indigo-500/20 text-indigo-300 border-indigo-500/30 font-bold tracking-wider text-[10px] uppercase px-2 py-0.5">
            {exercise.exercise_type?.name || "Standard"}
          </Badge>
          <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <CreateExerciseDialog onSuccess={onEdit} />
            <AlertDialog>
              <AlertDialogTrigger asChild>
                <Button size="icon" variant="ghost" className="h-8 w-8 text-rose-400 hover:text-rose-300 hover:bg-rose-500/10">
                  <Trash className="h-4 w-4" />
                </Button>
              </AlertDialogTrigger>
              <AlertDialogContent className="glass-dialog">
                <AlertDialogHeader>
                  <AlertDialogTitle>¿Confirmar eliminación?</AlertDialogTitle>
                  <AlertDialogDescription className="text-slate-400">
                    Eliminarás permanentemente "{exercise.name_es}" de la base de datos.
                  </AlertDialogDescription>
                </AlertDialogHeader>
                <AlertDialogFooter>
                  <AlertDialogCancel className="bg-white/5 border-white/10 hover:bg-white/10 text-white">Cancelar</AlertDialogCancel>
                  <AlertDialogAction onClick={() => onDelete(exercise.id)} className="bg-rose-600 hover:bg-rose-700">
                    Eliminar
                  </AlertDialogAction>
                </AlertDialogFooter>
              </AlertDialogContent>
            </AlertDialog>
          </div>
        </div>
        <CardTitle className="text-xl font-black tracking-tight mt-2 line-clamp-1 text-slate-900 dark:text-white">
          {exercise.name_es}
        </CardTitle>
        <div className="text-xs text-slate-600 dark:text-slate-400 font-bold italic">
          {exercise.name_en || exercise.name_es}
        </div>
      </CardHeader>

      <CardContent className="space-y-5 pt-2 flex-grow">
        {/* Mixes Visual */}
        {(vectors.length > 0 || planes.length > 0) && (
          <div className="grid grid-cols-1 gap-4 bg-slate-50 dark:bg-black/40 p-4 rounded-xl border border-slate-200 dark:border-white/5 shadow-inner">
            <ExerciseMixVisual items={vectors} title="Vectores Dominantes" type="vector" />
            <ExerciseMixVisual items={planes} title="Planos de Movimiento" type="plane" />
          </div>
        )}

        {/* Tags Section */}
        <div className="flex flex-wrap gap-2 min-h-[40px]">
          {exercise.difficulty && (
            <Badge variant="outline" className={`text-[10px] border-none ${exercise.difficulty.name === "Avanzado" ? "bg-rose-500/10 text-rose-400" :
              exercise.difficulty.name === "Intermedio" ? "bg-amber-500/10 text-amber-400" :
                "bg-emerald-500/10 text-emerald-400"
              }`}>
              <Activity className="h-3 w-3 mr-1" />
              {exercise.difficulty.name}
            </Badge>
          )}
          {exercise.movement_pattern && (
            <Badge variant="outline" className="text-[10px] bg-sky-500/10 text-sky-400 border-none">
              <Layers className="h-3 w-3 mr-1" />
              {exercise.movement_pattern.name}
            </Badge>
          )}
          {exercise.ssc_demand && exercise.ssc_demand.name !== 'bajo' && (
            <Badge variant="outline" className="text-[10px] bg-indigo-500/10 text-indigo-400 border-none">
              <Zap className="h-3 w-3 mr-1" />
              SSC: {exercise.ssc_demand.name}
            </Badge>
          )}
        </div>

        {/* Footer info */}
        <div className="flex justify-between items-center pt-4 border-t border-white/10">
          <div className="flex flex-wrap gap-1 max-w-[140px]">
            {exercise.exercise_muscle.filter(m => m.role === 'primary').slice(0, 3).map((m, i) => (
              <Badge key={i} variant="secondary" className="bg-indigo-500/20 text-indigo-300 border-none text-[9px] px-1.5 py-0">
                {m.muscle.name.substring(0, 3).toUpperCase()}
              </Badge>
            ))}
            {exercise.exercise_muscle.filter(m => m.role === 'primary').length > 3 && (
              <span className="text-[9px] text-slate-600 dark:text-slate-400 font-bold">+{exercise.exercise_muscle.filter(m => m.role === 'primary').length - 3}</span>
            )}
          </div>

          <div className="flex gap-2">
            {!exercise.is_active && (
              <Badge variant="outline" className="text-[9px] border-rose-500/30 text-rose-500/50 bg-rose-500/5">OFF</Badge>
            )}
            {exercise.urlvideo && (
              <a href={exercise.urlvideo} target="_blank" rel="noopener" className="p-2 glass-card rounded-lg hover:neon-border group/v transition-all">
                <Video className="h-4 w-4 text-slate-400 group-hover/v:text-indigo-400" />
              </a>
            )}
            <Dialog>
              <DialogTrigger asChild>
                <button className="p-2 glass-card rounded-lg hover:neon-border group/i transition-all">
                  <Info className="h-4 w-4 text-slate-500 dark:text-slate-400 group-hover/i:text-indigo-400" />
                </button>
              </DialogTrigger>
              <DialogContent className="glass-dialog max-w-2xl text-slate-200">
                <DialogHeader>
                  <DialogTitle className="text-3xl font-black neon-text uppercase">{exercise.name_es}</DialogTitle>
                  <DialogDescription className="text-slate-400 text-lg">{exercise.description || 'Sin descripción disponible.'}</DialogDescription>
                </DialogHeader>
                <div className="grid grid-cols-2 gap-8 py-6">
                  <div className="space-y-6">
                    <Section title="Estructura Biomecánica">
                      <DataPoint label="Apoyo" value={exercise.laterality_support?.name} />
                      <DataPoint label="Carga" value={exercise.laterality_load?.name} />
                      <DataPoint label="Estabilidad Anti-Rot" value={exercise.antirotation_stability?.name} />
                    </Section>
                    <Section title="Exigencias Fisiológicas">
                      <DataPoint label="Demanda SSC" value={exercise.ssc_demand?.name} />
                      <DataPoint label="Demanda Impacto" value={exercise.impact_demand?.name} />
                    </Section>
                  </div>
                  <div className="space-y-6">
                    <Section title="Configuración">
                      <DataPoint label="Método" value={exercise.training_method?.name} />
                      <DataPoint label="Equipamiento" value={exercise.exercise_equipment.map(e => e.equipment.name).join(', ') || 'Peso Corporal'} />
                    </Section>
                    <Section title="Focalización Muscular">
                      <div className="flex flex-wrap gap-2">
                        {exercise.exercise_muscle.map((m, i) => (
                          <Badge key={i} variant={m.role === 'primary' ? 'default' : 'outline'} className="text-[10px] uppercase">
                            {m.muscle.name} ({m.role === 'primary' ? 'P' : 'S'})
                          </Badge>
                        ))}
                      </div>
                    </Section>
                  </div>
                </div>
              </DialogContent>
            </Dialog>
          </div>
        </div>
      </CardContent>
    </Card>
  );
}

function Section({ title, children }: { title: string, children: React.ReactNode }) {
  return (
    <div className="space-y-3">
      <h4 className="text-xs font-black text-indigo-400 uppercase tracking-[0.2em]">{title}</h4>
      <div className="space-y-2">{children}</div>
    </div>
  );
}

function DataPoint({ label, value }: { label: string, value?: string }) {
  return (
    <div className="flex justify-between text-sm py-1 border-b border-slate-100 dark:border-white/5">
      <span className="text-slate-600 dark:text-slate-500 font-bold">{label}:</span>
      <span className="text-slate-900 dark:text-slate-200 font-black capitalize">{value || 'N/A'}</span>
    </div>
  );
}

interface CreateExerciseDialogProps {
  editData?: Exercise;
  onSuccess: () => void;
}

function CreateExerciseDialog({ editData, onSuccess }: CreateExerciseDialogProps) {
  const isEdit = !!editData;
  const [open, setOpen] = useState(false);
  const [loading, setLoading] = useState(false);

  // State for catalogs
  const [options, setOptions] = useState<any>({
    planes: [],
    supports: [],
    loads: [],
    ssc: [],
    impact: [],
    antirot: [],
    methods: [],
    types: [],
    difficulties: [],
    patterns: [],
    equipments: [],
    vectors: []
  });

  const [formData, setFormData] = useState<any>({
    name_es: "",
    name_en: "",
    description: "",
    urlvideo: "",
    type_id: "",
    difficulty_id: "",
    training_method_id: "",
    laterality_support_id: "",
    laterality_load_id: "",
    ssc_demand_id: "",
    impact_demand_id: "",
    antirotation_stability_id: "",
    movement_pattern_id: "",
  });

  // Simplified mix handling for now - would usually need a more complex component
  // We'll use the 100% in one value approach for creation via simple selects
  // unless we build a full mix UI. Showing selects for a "Primary" value for now.

  useEffect(() => {
    if (open) {
      const fetchOptions = async () => {
        const [
          planes, supports, loads, ssc, impact, antirot, methods, types, diffs, patterns, equips, vectors
        ] = await Promise.all([
          supabase.from("plane").select("id, name"),
          supabase.from("laterality_support").select("id, name"),
          supabase.from("laterality_load").select("id, name"),
          supabase.from("ssc_demand").select("id, name"),
          supabase.from("impact_demand").select("id, name"),
          supabase.from("antirotation_stability").select("id, name"),
          supabase.from("training_method").select("id, name"),
          supabase.from("exercise_type").select("id, name"),
          supabase.from("difficulty_level").select("id, name"),
          supabase.from("movement_pattern").select("id, name"),
          supabase.from("equipment").select("id, name"),
          supabase.from("dominant_vector").select("id, name")
        ]);

        setOptions({
          planes: planes.data || [],
          supports: supports.data || [],
          loads: loads.data || [],
          ssc: ssc.data || [],
          impact: impact.data || [],
          antirot: antirot.data || [],
          methods: methods.data || [],
          types: types.data || [],
          difficulties: diffs.data || [],
          patterns: patterns.data || [],
          equipments: equips.data || [],
          vectors: vectors.data || []
        });
      };
      fetchOptions();
    }
  }, [open]);

  useEffect(() => {
    if (editData) {
      setFormData({
        name_es: editData.name_es,
        name_en: editData.name_en || "",
        description: editData.description || "",
        urlvideo: editData.urlvideo || "",
        type_id: editData.type_id?.toString() || "",
        difficulty_id: editData.difficulty_id?.toString() || "",
        training_method_id: editData.training_method_id?.toString() || "",
        laterality_support_id: editData.laterality_support_id?.toString() || "",
        laterality_load_id: editData.laterality_load_id?.toString() || "",
        ssc_demand_id: editData.ssc_demand_id?.toString() || "",
        impact_demand_id: editData.impact_demand_id?.toString() || "",
        antirotation_stability_id: editData.antirotation_stability_id?.toString() || "",
        movement_pattern_id: editData.movement_pattern_id?.toString() || "",
      });
    } else {
      setFormData({
        name_es: "",
        name_en: "",
        description: "",
        urlvideo: "",
        type_id: "",
        difficulty_id: "",
        training_method_id: "",
        laterality_support_id: "",
        laterality_load_id: "",
        ssc_demand_id: "",
        impact_demand_id: "",
        antirotation_stability_id: "",
        movement_pattern_id: "",
      });
    }
  }, [editData, open]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);

    const dataToSave = {
      ...formData,
      type_id: parseInt(formData.type_id) || null,
      difficulty_id: parseInt(formData.difficulty_id) || null,
      training_method_id: parseInt(formData.training_method_id) || null,
      laterality_support_id: parseInt(formData.laterality_support_id) || null,
      laterality_load_id: parseInt(formData.laterality_load_id) || null,
      ssc_demand_id: parseInt(formData.ssc_demand_id) || null,
      impact_demand_id: parseInt(formData.impact_demand_id) || null,
      antirotation_stability_id: parseInt(formData.antirotation_stability_id) || null,
      movement_pattern_id: parseInt(formData.movement_pattern_id) || null,
    };

    let error;
    if (isEdit) {
      const res = await supabase.from("exercise").update(dataToSave).eq("id", editData.id);
      error = res.error;
    } else {
      const res = await supabase.from("exercise").insert(dataToSave);
      error = res.error;
    }

    if (error) {
      console.error("Error saving exercise:", error);
    } else {
      onSuccess();
      setOpen(false);
    }
    setLoading(false);
  };

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        {isEdit ? (
          <Button size="icon" variant="ghost" className="h-8 w-8 text-indigo-400 hover:text-indigo-300 hover:bg-indigo-500/10">
            <Edit className="h-4 w-4" />
          </Button>
        ) : (
          <Button className="bg-indigo-600 hover:bg-indigo-700 shadow-[0_0_20px_rgba(79,70,229,0.3)]">
            <Plus className="mr-2 h-4 w-4" />
            NUEVO EJERCICIO
          </Button>
        )}
      </DialogTrigger>
      <DialogContent className="glass-dialog max-w-4xl max-h-[90vh] overflow-y-auto">
        <DialogHeader>
          <DialogTitle className="text-3xl font-black neon-text italic">
            {isEdit ? "RE-AJUSTAR PARÁMETROS" : "REGISTRAR POTENCIAL"}
          </DialogTitle>
          <DialogDescription className="text-slate-400">
            Define las coordenadas biomecánicas y fisiológicas del ejercicio.
          </DialogDescription>
        </DialogHeader>

        <form onSubmit={handleSubmit} className="space-y-8 py-4">
          {/* Section: Basic Info */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="space-y-2">
              <Label className="text-slate-500 text-[10px] uppercase font-bold">Identificación principal</Label>
              <Input
                placeholder="Nombre en español"
                value={formData.name_es}
                onChange={e => setFormData({ ...formData, name_es: e.target.value })}
                className="bg-white/5 border-white/10"
              />
            </div>
            <div className="space-y-2 pt-6">
              <Input
                placeholder="English identification"
                value={formData.name_en}
                onChange={e => setFormData({ ...formData, name_en: e.target.value })}
                className="bg-white/5 border-white/10 italic"
              />
            </div>
          </div>

          {/* Section: Biomechanics Grid */}
          <div className="space-y-4">
            <h3 className="text-xs font-black text-indigo-500 uppercase tracking-widest border-b border-indigo-500/20 pb-1">Perfil Biomecánico</h3>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              <SelectField label="Patrón de Movimiento" value={formData.movement_pattern_id} options={options.patterns} onChange={v => setFormData({ ...formData, movement_pattern_id: v })} />
              <SelectField label="Tipo Apoyo" value={formData.laterality_support_id} options={options.supports} onChange={v => setFormData({ ...formData, laterality_support_id: v })} />
              <SelectField label="Tipo Carga" value={formData.laterality_load_id} options={options.loads} onChange={v => setFormData({ ...formData, laterality_load_id: v })} />
              <SelectField label="Estabilidad Antirotación" value={formData.antirotation_stability_id} options={options.antirot} onChange={v => setFormData({ ...formData, antirotation_stability_id: v })} />
              <SelectField label="Método Sugerido" value={formData.training_method_id} options={options.methods} onChange={v => setFormData({ ...formData, training_method_id: v })} />
              <SelectField label="Nivel Dificultad" value={formData.difficulty_id} options={options.difficulties} onChange={v => setFormData({ ...formData, difficulty_id: v })} />
            </div>
          </div>

          {/* Section: Physiology Grid */}
          <div className="space-y-4">
            <h3 className="text-xs font-black text-emerald-500 uppercase tracking-widest border-b border-emerald-500/20 pb-1">Perfil Fisiológico</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <SelectField label="Demanda SSC (Elasticidad)" value={formData.ssc_demand_id} options={options.ssc} onChange={v => setFormData({ ...formData, ssc_demand_id: v })} />
              <SelectField label="Demanda Impacto" value={formData.impact_demand_id} options={options.impact} onChange={v => setFormData({ ...formData, impact_demand_id: v })} />
            </div>
          </div>

          {/* Section: Media & Desc */}
          <div className="space-y-4">
            <h3 className="text-xs font-black text-slate-500 uppercase tracking-widest border-b border-white/5 pb-1">Recursos y Descripción</h3>
            <Input
              placeholder="URL de vídeo (Youtube, Vimeo, etc.)"
              value={formData.urlvideo}
              onChange={e => setFormData({ ...formData, urlvideo: e.target.value })}
              className="bg-white/5 border-white/10"
            />
            <textarea
              placeholder="Descripción detallada, notas de setup o precauciones..."
              value={formData.description}
              onChange={e => setFormData({ ...formData, description: e.target.value })}
              className="w-full h-24 rounded-lg bg-white/5 border border-white/10 p-3 text-sm focus:ring-1 focus:ring-indigo-500 outline-none"
            />
          </div>

          <Button type="submit" disabled={loading} className="w-full py-6 text-lg font-black tracking-widest bg-indigo-600 hover:neon-border transition-all">
            {loading ? "SINCRONIZANDO..." : (isEdit ? "ACTUALIZAR CORE" : "DESPLEGAR EJERCICIO")}
          </Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}

function SelectField({ label, value, options, onChange }: { label: string, value: string, options: any[], onChange: (v: string) => void }) {
  return (
    <div className="space-y-2">
      <Label className="text-[10px] uppercase text-slate-500 font-bold ml-1">{label}</Label>
      <Select value={value} onValueChange={onChange}>
        <SelectTrigger className="bg-white/5 border-white/10 h-10">
          <SelectValue placeholder="Seleccionar..." />
        </SelectTrigger>
        <SelectContent className="glass-dialog">
          {options.map((opt) => (
            <SelectItem key={opt.id} value={opt.id.toString()}>
              {opt.name}
            </SelectItem>
          ))}
        </SelectContent>
      </Select>
    </div>
  );
}
